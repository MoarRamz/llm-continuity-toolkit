<Window x:Class="LLMContinuityToolkit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LLM Continuity Toolkit" Height="820" Width="1240" MinHeight="680" MinWidth="980"
        Background="{StaticResource WindowBackground}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.Name="LLM Continuity Toolkit">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="LLM Continuity Toolkit" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Local-first conversation reconstruction, archival, and continuation utility" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                <TextBlock Text="Developed by DevMoarRamz" Foreground="{StaticResource DisabledTextBrush}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Right"/>
                <Button Content="ⓘ About" Click="AboutButton_Click" Padding="10,4" Margin="0,7,0,0" HorizontalAlignment="Right"
                        ToolTip="About LLM Continuity Toolkit" AutomationProperties.Name="About LLM Continuity Toolkit"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ImportHeadline" Text="No export loaded" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ImportDetail" Text="Choose the ZIP file supplied by OpenAI account Data Export." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
                <Button x:Name="ImportButton" Grid.Column="1" Content="Import OpenAI account Export" Click="ImportButton_Click" MinWidth="185"
                        AutomationProperties.Name="Import OpenAI account export"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Margin="0,4,8,4">
                <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="Search titles and dates"
                         AutomationProperties.Name="Search conversations"/>
                <TextBlock x:Name="SearchPlaceholder" Text="Search conversations..." Foreground="{StaticResource DisabledTextBrush}" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <ComboBox x:Name="FormatCombo" Grid.Column="1" Width="245" SelectedIndex="0" Margin="4"
                      ToolTip="Choose export format" AutomationProperties.Name="Export format">
                <ComboBoxItem Content="Continuation Markdown — Recommended" Tag="ContinuationMarkdown"/>
                <ComboBoxItem Content="Markdown" Tag="Markdown"/>
                <ComboBoxItem Content="HTML" Tag="Html"/>
                <ComboBoxItem Content="Plain text" Tag="PlainText"/>
                <ComboBoxItem Content="Complete Conversation JSON" Tag="CompleteJson"/>
            </ComboBox>
            <Button x:Name="ExportButton" Grid.Column="2" Content="Export Selected" Click="ExportButton_Click" IsEnabled="False" MinWidth="135"
                    AutomationProperties.Name="Export selected conversations"/>
            <Button x:Name="CancelButton" Grid.Column="3" Content="Cancel" Click="CancelButton_Click" Visibility="Collapsed" Background="#B45309" BorderBrush="#B45309"
                    AutomationProperties.Name="Cancel current operation"/>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <DataGrid x:Name="ConversationGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" Background="{StaticResource PanelBackground}" Foreground="{StaticResource TextBrush}" BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Extended" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      AutomationProperties.Name="Imported conversations">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="42">
                        <DataGridCheckBoxColumn.Header>
                            <TextBlock Text="✓" ToolTip="Select conversation" AutomationProperties.Name="Select conversation"/>
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Header="Conversation" Binding="{Binding Record.Title}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Created" Binding="{Binding Record.Created}" Width="145" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Updated" Binding="{Binding Record.Updated}" Width="145" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Messages" Binding="{Binding Record.MessageCount}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Attachments" Binding="{Binding Record.AttachmentCount}" Width="95" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4" Margin="0,10,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <Button x:Name="SelectVisibleButton" Grid.Column="1" Content="Select visible" Click="SelectVisible_Click" Padding="10,5"
                    AutomationProperties.Name="Select visible conversations"/>
            <Button x:Name="ClearVisibleButton" Grid.Column="2" Content="Clear visible" Click="ClearVisible_Click" Padding="10,5"
                    AutomationProperties.Name="Clear visible conversation selections"/>
            <Button x:Name="ClearAllButton" Grid.Column="3" Content="Clear all" Click="ClearAll_Click" Padding="10,5"
                    AutomationProperties.Name="Clear all conversation selections"/>
            <CheckBox x:Name="AutoScrollCheck" Grid.Column="5" Content="Auto-scroll" IsChecked="True" VerticalAlignment="Center" Margin="8,0"
                      AutomationProperties.Name="Automatically scroll activity log"/>
            <Button x:Name="PauseLogButton" Grid.Column="6" Content="Pause" Click="PauseLog_Click" Padding="10,5"
                    AutomationProperties.Name="Pause activity log display"/>
            <Button Grid.Column="7" Content="Copy" Click="CopyLog_Click" Padding="10,5" AutomationProperties.Name="Copy activity log"/>
            <Button Grid.Column="8" Content="Clear Log" Click="ClearLog_Click" Padding="10,5" AutomationProperties.Name="Clear activity log"/>
            <Button Grid.Column="9" Content="Save Log..." Click="SaveLog_Click" Padding="10,5" AutomationProperties.Name="Save activity log"/>
            <Button Grid.Column="10" Content="Save Redacted..." Click="SaveRedactedLog_Click" Padding="10,5" ToolTip="Save diagnostics with conversation titles, identifiers, and local filesystem values pseudonymized"
                    AutomationProperties.Name="Save redacted activity log"/>
        </Grid>

        <Border Grid.Row="5" Background="#0B1220" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <ListBox x:Name="ActivityList" Background="#0B1220" Foreground="#C7D2FE" BorderThickness="0" FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     AutomationProperties.Name="Activity log">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="6,2"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="6" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
            <ProgressBar x:Name="ProgressBar" Grid.Column="1" Width="280" Height="14" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="Operation progress"/>
        </Grid>
    </Grid>
</Window>
