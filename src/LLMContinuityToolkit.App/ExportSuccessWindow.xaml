<Window x:Class="LLMContinuityToolkit.App.ExportSuccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export complete" Width="650" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}">
    <Border Padding="22"><StackPanel>
        <TextBlock x:Name="Headline" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBlock x:Name="Summary" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        <TextBlock x:Name="AttachmentSummary" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="PathText" Margin="0,14,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="HelpText" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CopyPromptButton" Content="Copy Continuation Prompt" Click="CopyPromptButton_Click" MinWidth="190"/><Button Content="Open Folder" Click="OpenFolder_Click" MinWidth="105"/><Button Content="Done" Click="Done_Click" MinWidth="80"/>
        </StackPanel>
    </StackPanel></Border>
</Window>
